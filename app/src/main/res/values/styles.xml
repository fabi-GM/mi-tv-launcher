<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema explícitamente opaco: en algunos firmwares DeviceDefault sale translúcido
         y la app de TV sigue viéndose por debajo del Home. -->
    <style name="LauncherTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
